# =============================================================================
# OFF Barcode Lookup Server — Config
# =============================================================================

# API key for programmatic access (CHANGE THIS!)
API_KEY=changeme

# JWT secret for web authentication (CHANGE THIS!)
JWT_SECRET=change-this-secret-in-production

# SQLite path for users and custom products
SQLITE_PATH=/data/app.db

# Port mapping (host:container)
APP_PORT=8090

# DuckDB
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# Image cache
MAX_IMAGE_CACHE_GB=20
IMAGE_CACHE_TTL_DAYS=90

# Pre-cache Brazilian products (set to true after first run)
PRECACHE_BRAZILIAN=false

# Dataset refresh hour (UTC)
REFRESH_HOUR_UTC=4
